# ConvertKit Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ConvertKit Form ID (required for form submission)
# Get from: https://app.convertkit.com/forms/YOUR_FORM_ID_HERE/
PUBLIC_CONVERTKIT_FORM_ID=your_form_id_here

# ConvertKit API Key (optional, for advanced API usage)
# Get from: Account → Settings → API Key
PUBLIC_CONVERTKIT_API_KEY=your_api_key_here

# Google Analytics (already configured with delayed loading)
PUBLIC_GA_TRACKING_ID=G-MQ633HZM4L

# Site URL
PUBLIC_SITE_URL=https://certifly.tech

# Environment
NODE_ENV=production