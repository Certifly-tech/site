---
import Logo from './Logo.astro';
---
<footer>
  <div class="container">
    <a href="/" class="logo">
      <Logo size={30} />
      Certifly
    </a>
    <p>Professional Certification for SaaS</p>
    <p class="footer-links">
      <a href="/privacy">Privacy Policy</a> · <a href="/terms">Terms of Service</a> · <a href="/blog">Blog</a>
    </p>
    <p class="footer-copy">© {new Date().getFullYear()} Certifly. All rights reserved.</p>
  </div>
</footer>

<style>
  footer {
    padding: 48px 0; border-top: 1px solid var(--border-subtle);
    text-align: center; color: var(--text-muted); font-size: 13px;
  }
  footer .logo {
    font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 22px;
    text-decoration: none; color: var(--text-primary);
    display: inline-flex; align-items: center; gap: 8px;
    margin-bottom: 16px; justify-content: center;
  }
  footer p { margin-bottom: 6px; }
  .footer-links { margin-top: 12px; }
  .footer-copy { margin-top: 8px; }
</style>
