---
interface Props {
  buttonText?: string;
  subText?: string;
  placeholder?: string;
}

const { 
  buttonText = 'Join the Waitlist →', 
  subText = 'Free early access. No credit card. Launching Q2 2026.',
  placeholder = 'your@workemail.com'
} = Astro.props;

const convertKitFormId = "9138922";
---

<form 
  class="cta-form" 
  data-convertkit-form
  action={`https://app.convertkit.com/forms/${convertKitFormId}/subscriptions`}
  method="post"
>
  <input 
    type="email" 
    name="email_address"
    placeholder={placeholder} 
    required 
    aria-label="Email address"
    value={Astro.props.email || ''}
  >
  <button type="submit">
    {buttonText}
  </button>
  
  <!-- ConvertKit hidden fields - MINIMAL working payload -->
  <!-- DO NOT include fields={} - causes Internal Server Error -->
  <input type="hidden" name="form_id" value="9138922">
  
  <!-- Privacy-friendly honeypot -->
  <div style="position: absolute; left: -5000px;" aria-hidden="true">
    <input type="text" name="first_name" tabindex="-1" autoComplete="off" />
  </div>
</form>

{subText && <p class="cta-sub">{subText}</p>}

<script>
  // ConvertKit form handling with enhanced UX
  document.addEventListener('DOMContentLoaded', function() {
    const forms = document.querySelectorAll('[data-convertkit-form]');
    
    forms.forEach(form => {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const submitBtn = this.querySelector('button[type="submit"]');
        const emailInput = this.querySelector('input[type="email"]');
        const originalBtnText = submitBtn.textContent;
        const email = emailInput.value.trim();
        
        // Validate email format
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!email || !emailRegex.test(email)) {
          alert('Please enter a valid email address');
          return;
        }
        
        // Disable UI
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting...';
        emailInput.disabled = true;
        
        // Save to localStorage first
        saveToLocalStorage(email);
        
        // Track conversion if GA is available (even if form fails)
        if (typeof gtag !== 'undefined') {
          gtag('event', 'waitlist_signup', {
            'event_category': 'conversion',
            'event_label': 'waitlist'
          });
        }
        
        // Show success state immediately
        submitBtn.textContent = '✓ You\'re on the list!';
        submitBtn.style.background = '#037f4c';
        emailInput.value = '';
        
        // Submit to ConvertKit in background
        // Build payload manually to avoid fields={} issue
        const params = new URLSearchParams();
        params.append('email_address', email);
        params.append('form_id', '9138922');
        params.append('referrer', 'https://certifly.tech');
        params.append('landing_url', window.location.href);
        params.append('user_agent', navigator.userAgent);
        
        // Try ConvertKit submission
        fetch(this.action, {
          method: 'POST',
          body: params,
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json'
          }
        })
        .then(response => response.json())
        .then(data => {
          console.log('ConvertKit response:', data);
          if (data.status === 'success') {
            console.log('✅ ConvertKit submission successful');
          } else {
            console.warn('⚠️ ConvertKit responded with:', data.errors || data.message);
          }
        })
        .catch(error => {
          console.error('❌ ConvertKit submission error:', error);
          // Fallback: Submit the form normally (page reload)
          // this.submit();
        });
        
        // Reset form after 3 seconds
        setTimeout(() => {
          submitBtn.textContent = originalBtnText;
          submitBtn.style.background = '';
          submitBtn.disabled = false;
          emailInput.disabled = false;
        }, 3000);
      });
    });
  });
  
  function saveToLocalStorage(email) {
    try {
      const waitlist = JSON.parse(localStorage.getItem('certifly_waitlist') || '[]');
      waitlist.push({
        email: email,
        timestamp: new Date().toISOString(),
        source: window.location.href,
        user_agent: navigator.userAgent
      });
      localStorage.setItem('certifly_waitlist', JSON.stringify(waitlist));
      console.log('📝 Saved to localStorage:', waitlist.length, 'total signups');
    } catch (e) {
      console.log('⚠️ Could not save to localStorage');
    }
  }
</script>

<style>
  .cta-form {
    display: flex; gap: 10px; max-width: 460px; flex-wrap: wrap;
  }
  .cta-form input[type="email"] {
    flex: 1; min-width: 220px; padding: 14px 18px;
    border-radius: 10px; border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.05); color: var(--text-primary);
    font-size: 16px; font-family: 'DM Sans', sans-serif;
    outline: none; transition: border-color 0.3s;
  }
  .cta-form input[type="email"]::placeholder { color: var(--text-muted); }
  .cta-form input[type="email"]:focus { border-color: var(--magenta); }
  .cta-form button {
    padding: 14px 28px; border-radius: 10px; border: none;
    background: var(--gradient); color: white; font-size: 16px;
    font-weight: 600; cursor: pointer; font-family: 'DM Sans', sans-serif;
    white-space: nowrap; transition: transform 0.2s, box-shadow 0.3s;
  }
  .cta-form button:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 30px var(--glow-magenta);
  }
  .cta-form button:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }
  .cta-sub { font-size: 13px; color: var(--text-muted); margin-top: 10px; }

  @media (max-width: 768px) {
    .cta-form { flex-direction: column; }
    .cta-form input[type="email"] { min-width: 100%; }
    .cta-form button { width: 100%; }
  }
</style>