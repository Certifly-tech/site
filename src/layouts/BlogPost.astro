---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  image?: string;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, author = 'Certifly Team', image, tags = [] } = Astro.props;

const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "author": { "@type": "Person", "name": author },
  "datePublished": pubDate.toISOString(),
  ...(updatedDate && { "dateModified": updatedDate.toISOString() }),
  "publisher": { "@type": "Organization", "name": "Certifly" },
  ...(image && { "image": image }),
});
---

<Base
  title={`${title} | Certifly Blog`}
  description={description}
  ogType="article"
  ogImage={image}
  schema={articleSchema}
>
  <article class="blog-post">
    <div class="container">
      <header class="post-header fade-up">
        <div class="post-meta">
          <time datetime={pubDate.toISOString()}>
            {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          {author && <span class="post-author">· {author}</span>}
        </div>
        <h1>{title}</h1>
        <p class="post-description">{description}</p>
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map(tag => <span class="post-tag">{tag}</span>)}
          </div>
        )}
      </header>
      <div class="post-content fade-up">
        <slot />
      </div>
      <footer class="post-footer fade-up">
        <a href="/blog" class="back-link">← Back to Blog</a>
      </footer>
    </div>
  </article>
</Base>

<style>
  .blog-post { padding-top: 140px; padding-bottom: var(--section-pad); }
  .post-header { max-width: 720px; margin-bottom: 48px; }
  .post-meta { font-size: 14px; color: var(--text-muted); margin-bottom: 16px; }
  .post-author { color: var(--text-secondary); }
  .post-header h1 { font-size: clamp(32px, 4vw, 48px); margin-bottom: 16px; }
  .post-description { font-size: 19px; color: var(--text-secondary); line-height: 1.6; }
  .post-tags { display: flex; gap: 8px; margin-top: 16px; flex-wrap: wrap; }
  .post-tag { padding: 4px 12px; border-radius: 20px; font-size: 12px; border: 1px solid var(--border-subtle); color: var(--text-secondary); }

  .post-content { max-width: 720px; }
  .post-content :global(h2) { font-size: 28px; margin-top: 48px; margin-bottom: 16px; }
  .post-content :global(h3) { font-size: 22px; margin-top: 36px; margin-bottom: 12px; }
  .post-content :global(p) { color: var(--text-primary) !important; line-height: 1.8; margin-bottom: 20px; }
  .post-content :global(a) { color: var(--magenta) !important; text-decoration: underline; }
  .post-content :global(a:hover) { color: var(--magenta) !important; text-decoration: none; }
  .post-content :global(strong) { color: var(--magenta) !important; font-weight: 700; }
  .post-content :global(code) { font-family: 'JetBrains Mono', monospace; font-size: 0.9em; background: rgba(255,255,255,0.05); padding: 2px 6px; border-radius: 4px; }
  .post-content :global(pre) { background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: 10px; padding: 20px; overflow-x: auto; margin: 24px 0; }
  .post-content :global(pre code) { background: none; padding: 0; }
  .post-content :global(blockquote) { border-left: 3px solid var(--magenta); padding-left: 20px; margin: 24px 0; color: var(--text-primary) !important; font-style: italic; background: rgba(241, 0, 255, 0.05); padding: 16px 20px; border-radius: 8px; }
  .post-content :global(ul), .post-content :global(ol) { color: var(--text-primary) !important; padding-left: 24px; margin-bottom: 20px; }
  .post-content :global(li) { margin-bottom: 8px; line-height: 1.7; }
  .post-content :global(img) { max-width: 100%; border-radius: 12px; margin: 24px 0; }
  
  .post-content :global(table) { 
    margin: 2.5rem 0; 
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    width: 100%;
    max-width: 100%;
  }
  .post-content :global(th) { 
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 0.9em;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--magenta);
    background: linear-gradient(90deg, var(--bg-card), var(--bg-card-hover));
    padding: 1rem 1.5rem;
    border-bottom: 2px solid var(--border-glow);
    white-space: nowrap;
  }
  .post-content :global(td) { 
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-primary) !important;
    min-width: 120px;
  }
  .post-content :global(tbody tr:hover) {
    background: var(--bg-card-hover);
  }
  .post-content :global(tbody tr:nth-child(even)) {
    background: rgba(255, 255, 255, 0.02);
  }
  .post-content :global(td strong) {
    color: var(--text-primary);
  }
  
  @media (max-width: 768px) {
    .post-content :global(table) {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border-radius: 8px;
      margin: 1.5rem -1rem;
      width: calc(100% + 2rem);
      max-width: none;
      font-size: 0.9em;
    }
    .post-content :global(th),
    .post-content :global(td) {
      padding: 0.75rem 1rem;
      min-width: 100px;
    }
    .post-content :global(th) {
      font-size: 0.8em;
      padding: 0.75rem 0.5rem;
    }
  }

  .post-footer { margin-top: 64px; padding-top: 32px; border-top: 1px solid var(--border-subtle); }
  .back-link { color: var(--text-secondary); font-size: 15px; }
  .back-link:hover { color: var(--magenta); }
</style>
