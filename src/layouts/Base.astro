---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  schema?: string;
}

const {
  title,
  description,
  ogImage = 'https://certifly.tech/og-image.png',
  ogType = 'website',
  canonicalUrl,
  schema,
} = Astro.props;

const canonical = canonicalUrl || Astro.url.href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="index, follow">
  <link rel="canonical" href={canonical}>
  
  <!-- Critical CSS Inline -->
  <style>
    /* Minimal critical CSS for above-the-fold content */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { 
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-display: swap;
      background: #0a0a1a; color: #f0f0f5; overflow-x: hidden;
    }
    /* Font optimization - show system font until custom fonts load */
    .fonts-loading { font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important; }
    .fonts-loaded { font-family: 'DM Sans', system-ui, sans-serif !important; }
    .loading-bar {
      height: 3px; background: linear-gradient(135deg, #f100ff, #0000b8);
      width: 0%; position: fixed; top: 0; left: 0; z-index: 10000;
      animation: loading 2s ease-in-out infinite;
    }
    @keyframes loading {
      0% { width: 0%; left: 0%; }
      50% { width: 50%; left: 25%; }
      100% { width: 0%; left: 100%; }
    }
    .fonts-loading { font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
    .fonts-loaded { font-family: 'DM Sans', system-ui, sans-serif; }
  </style>
  
  <!-- Preload and preconnect for critical resources -->
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>
  <link rel="dns-prefetch" href="https://fonts.googleapis.com">
  <link rel="dns-prefetch" href="https://fonts.gstatic.com">
  <link rel="dns-prefetch" href="https://www.googletagmanager.com">
  
  <!-- Preload critical font weights -->
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=DM+Sans:wght@400;600&display=swap&subset=latin&display=swap" as="style">
  
  <!-- Async load fonts with font-display: swap and subset latin -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=DM+Sans:wght@400;600&display=swap&subset=latin" media="print" onload="this.onload=null;this.media='all'">
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=DM+Sans:wght@400;600&display=swap&subset=latin">
  </noscript>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/certifly.svg">
  <link rel="icon" type="image/png" href="/certifly.svg" sizes="any">

  <!-- Open Graph -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>

  <!-- Organization Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Certifly",
    "url": "https://certifly.tech",
    "description": "AI-powered professional certification platform for B2B SaaS products",
    "foundingDate": "2026"
  })} />

  <!-- Page-specific schema -->
  {schema && <script type="application/ld+json" set:html={schema} />}

  <!-- Google Analytics - Load after 5 seconds or on user interaction -->
  <script>
    // Defer GA until 5 seconds after load OR on first interaction
    function loadGoogleAnalytics() {
      var script = document.createElement('script');
      script.src = 'https://www.googletagmanager.com/gtag/js?id=G-MQ633HZM4L';
      script.async = true;
      script.defer = true;
      document.head.appendChild(script);
      
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-MQ633HZM4L', { 'transport_type': 'beacon' });
    }
    
    // Load GA after 5 seconds OR on first user interaction
    setTimeout(loadGoogleAnalytics, 5000);
    
    // Alternatively load on first user interaction
    ['click', 'touchstart', 'keydown', 'scroll', 'mousemove'].forEach(function(event) {
      window.addEventListener(event, function loadGAOnInteraction() {
        loadGoogleAnalytics();
        // Remove listeners after first interaction
        ['click', 'touchstart', 'keydown', 'scroll', 'mousemove'].forEach(function(e) {
          window.removeEventListener(e, loadGAOnInteraction);
        });
      }, { once: true, passive: true });
    });
  </script>

  <!-- Defer loading of main CSS -->
  <link rel="preload" href="/_astro/index.DSxHBuTC.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/_astro/index.DSxHBuTC.css"></noscript>

  <slot name="head" />
</head>
<body>
  <noscript><style>{'  .fade-up { opacity: 1 !important; transform: none !important; }'}</style></noscript>

  <Navbar />

  <slot />

  <Footer />

  <!-- Loading bar - deferred since not critical -->
  <script defer>
    (function() {
      // Show loading bar
      const loadingBar = document.createElement('div');
      loadingBar.className = 'loading-bar';
      document.body.insertBefore(loadingBar, document.body.firstChild);
      
      // Hide when page loads
      window.addEventListener('load', function() {
        setTimeout(function() {
          if (loadingBar.parentNode) {
            loadingBar.style.opacity = '0';
            setTimeout(function() {
              if (loadingBar.parentNode) {
                loadingBar.parentNode.removeChild(loadingBar);
              }
            }, 500);
          }
        }, 300);
      });
    })();
  </script>
  
  <!-- Deferred performance optimizer (animations only) -->
  <script defer>
    // Minimal IntersectionObserver for fade-up animations
    (function() {
      if (window.IntersectionObserver) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '40px 0px 40px 0px' });
        
        document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
      }
    })();
  </script>
</body>
</html>
