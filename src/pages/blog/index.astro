---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base
  title="Blog | Certifly — SaaS Certification & Retention Insights"
  description="Insights on SaaS certification, user engagement, product-led growth, and reducing churn through professional credentialing."
>
  <section class="blog-index">
    <div class="container">
      <header class="blog-header fade-up">
        <h1>The Certifly <span class="gradient-text">Blog</span></h1>
        <p>Insights on SaaS certification, user engagement, and product-led retention.</p>
      </header>

      {posts.length === 0 ? (
        <div class="empty-state fade-up">
          <p>No posts yet. Stay tuned — we're writing about SaaS certification, churn reduction, and the future of user engagement.</p>
          <a href="/#waitlist" class="empty-cta">Join the Waitlist for Updates →</a>
        </div>
      ) : (
        <div class="posts-grid">
          {posts.map(post => (
            <a href={`/blog/${post.id.replace(/\.md$/, '')}/`} class="post-card fade-up">
              {post.data.image && <img src={post.data.image} alt={post.data.title} class="post-image" />}
              <div class="post-card-body">
                <div class="post-card-meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                  {post.data.tags.length > 0 && <span class="post-card-tag">{post.data.tags[0]}</span>}
                </div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .blog-index { padding-top: 140px; padding-bottom: var(--section-pad); }
  .blog-header { margin-bottom: 56px; }
  .blog-header h1 { margin-bottom: 12px; }
  .blog-header p { color: var(--text-secondary); font-size: 19px; }

  .posts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 24px; }
  .post-card {
    background: var(--bg-card); border: 1px solid var(--border-subtle);
    border-radius: 14px; overflow: hidden; text-decoration: none;
    transition: border-color 0.3s, transform 0.3s;
  }
  .post-card:hover { border-color: var(--border-glow); transform: translateY(-3px); color: var(--text-primary); }
  .post-image { width: 100%; height: 200px; object-fit: cover; }
  .post-card-body { padding: 24px; }
  .post-card-meta { font-size: 13px; color: var(--text-muted); margin-bottom: 12px; display: flex; align-items: center; gap: 12px; }
  .post-card-tag { padding: 2px 8px; border-radius: 12px; border: 1px solid var(--border-subtle); font-size: 11px; color: var(--text-secondary); }
  .post-card h2 { font-size: 20px; margin-bottom: 8px; color: var(--text-primary); }
  .post-card p { color: var(--text-secondary); font-size: 15px; line-height: 1.6; margin-bottom: 0; }

  .empty-state { text-align: center; padding: 80px 0; }
  .empty-state p { color: var(--text-secondary); font-size: 17px; max-width: 500px; margin: 0 auto 24px; }
  .empty-cta { display: inline-block; padding: 12px 28px; border-radius: 10px; background: var(--gradient); color: white; font-weight: 600; text-decoration: none; }

  @media (max-width: 768px) {
    .posts-grid { grid-template-columns: 1fr; }
  }
</style>
