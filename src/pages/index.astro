---
import Base from '../layouts/Base.astro';
import WaitlistForm from '../components/WaitlistForm.astro';

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {"@type": "Question", "name": "How is Certifly different from Appcues or Userpilot?", "acceptedAnswer": {"@type": "Answer", "text": "Appcues and Userpilot are product tour tools that show users where to click. Certifly is a certification platform that makes users want to master your domain. Product tours have around 3% completion rates while professional certification programs achieve 30-60%."}},
    {"@type": "Question", "name": "How is this different from an LMS like Skilljar or Northpass?", "acceptedAnswer": {"@type": "Answer", "text": "Traditional LMS platforms are external, cost over $1,000 per month, and require instructional designers. Certifly is embedded inside your SaaS, AI generates certification tracks from your actual product, and setup takes minutes instead of months."}},
    {"@type": "Question", "name": "Do I need an instructional designer?", "acceptedAnswer": {"@type": "Answer", "text": "No. Certifly's AI analyzes your product structure and domain, then generates a complete certification track with checkpoints, quizzes, and professional credential language. You review, tweak, and publish."}},
    {"@type": "Question", "name": "Will the SDK slow down my product?", "acceptedAnswer": {"@type": "Answer", "text": "The SDK is under 30KB gzipped, smaller than most analytics scripts. It observes passively, batches events, and ensures zero impact on your product's performance."}},
    {"@type": "Question", "name": "Is this just gamification?", "acceptedAnswer": {"@type": "Answer", "text": "No. Gamification uses extrinsic motivation like badges and points which fade quickly. Professional certification leverages intrinsic motivation including career growth, peer recognition, and expertise validation."}},
    {"@type": "Question", "name": "How long does integration take?", "acceptedAnswer": {"@type": "Answer", "text": "The SDK installs with 3 lines of code. The AI then observes your product and generates a certification track suggestion. Most teams go from install to live certification program in under a week."}},
    {"@type": "Question", "name": "What happens when users earn a certificate?", "acceptedAnswer": {"@type": "Answer", "text": "Users get a verifiable professional credential with a unique URL, shareable on LinkedIn with one click. The certificate page is branded with your company as the certifying authority."}}
  ]
});

const softwareSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Certifly",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "description": "Embed AI-powered professional certification programs inside your SaaS to reduce churn and increase feature adoption.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "description": "Free during beta, then starting at $299/mo",
    "availability": "https://schema.org/PreOrder"
  }
});

const faqs = [
  { q: "How is this different from Appcues or Userpilot?", a: "Appcues and Userpilot are product tour tools — they show users where to click. Certifly is a certification platform — it makes users want to master your domain. Product tours have ~3% completion rates. Professional certification programs have 30-60%. The difference? Motivation. Nobody puts \"completed onboarding\" on their LinkedIn. They will put \"Certified Marketing Analyst\" on their LinkedIn." },
  { q: "How is this different from an LMS like Skilljar or Northpass?", a: "Traditional LMS platforms are external — users leave your product to learn about your product. They cost $1,000+/month and require instructional designers. Certifly is embedded inside your SaaS, AI generates the certification tracks from your actual product, and setup takes minutes — not months." },
  { q: "Do I need an instructional designer?", a: "No. Our AI analyzes your product's structure and domain, then generates a complete certification track — checkpoints mapped to real features, quiz questions about domain expertise, and professional credential language. You review, tweak, and publish." },
  { q: "Will the SDK slow down my product?", a: "The SDK is under 30KB gzipped — smaller than most analytics scripts. It observes passively, batches events, and uses zero-impact DOM observation. We benchmark against Largest Contentful Paint to ensure your product's performance is never affected." },
  { q: "Is this just gamification with a different name?", a: "No. Gamification (badges, points, leaderboards) relies on extrinsic motivation — it works short-term and fades fast. Professional certification relies on intrinsic motivation — career growth, peer recognition, and expertise validation. People don't put badges on their resume. They put certifications." },
  { q: "How long does integration take?", a: "The SDK installs with 3 lines of code. Our AI then observes your product for a few days and generates a certification track suggestion. You review, customize if needed, and publish. Most teams go from install to live certification program in under a week." },
  { q: "What happens when users earn a certificate?", a: "They get a verifiable professional credential with a unique URL, shareable on LinkedIn with one click. The certificate page is branded with your company as the certifying authority — positioning your SaaS as the industry standard. Every share is organic marketing." },
];

const useCases = [
  { industry: "Marketing Analytics", cert: "Certified Performance Marketing Analyst", learn: "Campaign attribution, ROAS optimization, audience analysis", result: "Users adopt 3x more advanced features and share credentials with 500+ connections" },
  { industry: "HR Tech", cert: "Certified People Operations Specialist", learn: "Compliance workflows, org design, data-driven HR", result: "HR managers become internal advocates, driving seat expansion" },
  { industry: "DevOps / Infra", cert: "Certified Cloud Infrastructure Engineer", learn: "Deployment strategies, monitoring, incident response", result: "Engineers build professional identity around your platform" },
  { industry: "Fintech", cert: "Certified Financial Operations Professional", learn: "Reconciliation, reporting standards, audit readiness", result: "Finance teams standardize on your tool as \"the certified platform\"" },
];
---

<Base
  title="SaaS Certification Program | Reduce Churn with Certifly"
  description="Turn product usage into professional certifications. Reduce churn by 40%+ with AI-powered certification tracks embedded inside your SaaS. Join the waitlist."
  schema={`${faqSchema}</script><script type="application/ld+json">${softwareSchema}`}
>


<!-- ═══════ SECTION 1: HERO ═══════ -->
<section class="hero">
  <div class="container">
    <div class="hero-pretitle fade-up">For B2B SaaS with complex products</div>
    <h1 class="fade-up">
      SaaS Certification That Stops Churn at the Root.<br>
      <span class="gradient-text">Your Users Don't Leave Bad Products. They Leave Products They Never Truly Learned.</span>
    </h1>
    <p class="hero-sub fade-up">
      Certifly turns real product usage into professional certifications your users
      actually want to complete. AI-powered. Embedded in your SaaS. Live in minutes, not months.
    </p>
    <div class="fade-up" id="waitlist">
      <WaitlistForm subText="Free early access. No credit card. Launching Q2 2026." />
    </div>

    <!-- Product Mockup -->
    <div class="hero-visual fade-up">
      <div class="hero-mockup">
        <div class="mockup-main">
          <h4>📊 Your SaaS Dashboard</h4>
          <div class="mockup-content">
            <div class="mockup-panel">
              <div class="mockup-panel-label">Campaign Performance</div>
              <div class="mockup-bar"><div class="mockup-bar-fill" style="width:72%"></div></div>
              <div class="mockup-bar"><div class="mockup-bar-fill" style="width:45%"></div></div>
              <div class="mockup-bar"><div class="mockup-bar-fill" style="width:88%"></div></div>
            </div>
            <div class="mockup-stats">
              <div class="mockup-stat">
                <div class="mockup-stat-label">Active Users</div>
                <div class="mockup-stat-value">2,847</div>
              </div>
              <div class="mockup-stat">
                <div class="mockup-stat-label">Feature Adoption</div>
                <div class="mockup-stat-value" style="color:var(--magenta);">23%</div>
              </div>
            </div>
          </div>
        </div>
        <div class="mockup-sidebar">
          <div class="mockup-widget">
            <h4>🎓 Certification Progress</h4>
            <div class="mockup-widget-sub">Marketing Analytics Specialist</div>
            <div class="mockup-bar" style="margin-bottom:16px;">
              <div class="mockup-bar-fill" style="width:60%"></div>
            </div>
            <div class="checkpoint"><div class="checkpoint-dot done">✓</div> Audience Segmentation</div>
            <div class="checkpoint"><div class="checkpoint-dot done">✓</div> Campaign Setup</div>
            <div class="checkpoint"><div class="checkpoint-dot active"></div> ROI Analysis</div>
            <div class="checkpoint"><div class="checkpoint-dot"></div> Advanced Attribution</div>
            <div class="checkpoint"><div class="checkpoint-dot"></div> Final Assessment</div>
            <div class="linkedin-btn">🔗 Share on LinkedIn</div>
          </div>
        </div>
      </div>
    </div>

    <div class="trust-bar fade-up">
      <span>Works with any web SaaS:</span>
      <div class="trust-tags">
        {['React', 'Vue', 'Angular', 'Svelte', 'Any SPA'].map(tag => (
          <span class="trust-tag">{tag}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<div class="section-divider"></div>

<!-- ═══════ SECTION 2: PROBLEM ═══════ -->
<section class="problem section-pad">
  <div class="container">
    <h2 class="fade-up">The <span class="gradient-text">$1.6 Trillion</span> SaaS Churn Problem Nobody's Actually Solving</h2>
    <p class="muted fade-up">Here's what's really happening inside your SaaS right now.</p>

    <div class="stat-grid">
      <div class="stat-card fade-up">
        <div class="stat-number gradient-text">80%</div>
        <h3>of your features are invisible</h3>
        <p>Your users live in 3-4 screens. The other 80% of what you built? They don't know it exists. They never will — unless something changes.</p>
      </div>
      <div class="stat-card fade-up">
        <div class="stat-number gradient-text">5-7%</div>
        <h3>monthly revenue lost to churn</h3>
        <p>Not because the product failed. Because users never reached the moment where your product becomes indispensable to their workflow.</p>
      </div>
      <div class="stat-card fade-up">
        <div class="stat-number gradient-text">3%</div>
        <h3>product tour completion rate</h3>
        <p>You spent $50K/year on onboarding tools. Users click "Skip" on every tooltip. The onboarding nobody asked for, solving the problem nobody has at that moment.</p>
      </div>
    </div>

    <p class="problem-close fade-up">
      Product tours teach users <strong>where to click</strong>. But nobody churns because they couldn't find a button. They churn because they never understood <strong>why your product matters to their career</strong>.
    </p>
  </div>
</section>

<div class="section-divider"></div>

<!-- ═══════ SECTION 3: THE SHIFT ═══════ -->
<section class="shift section-pad">
  <div class="container">
    <h2 class="fade-up">Product Tours Failed.<br><span class="gradient-text">Embedded Certification Doesn't.</span></h2>

    <table class="comparison-table fade-up">
      <thead><tr><th></th><th>Product Tours (Old Way)</th><th>Certification (Certifly)</th></tr></thead>
      <tbody>
        <tr><td>Motivation</td><td>"I have to do this"</td><td>"I want this on my LinkedIn"</td></tr>
        <tr><td>Depth</td><td>Surface: click here, then here</td><td>Deep: understand the domain, prove mastery</td></tr>
        <tr><td>Completion</td><td>~3%</td><td>30–60% (credential programs avg)</td></tr>
        <tr><td>Retention impact</td><td>Marginal</td><td>Structural — user becomes invested</td></tr>
        <tr><td>Marketing value</td><td>None</td><td>Every certificate shared = free impression</td></tr>
        <tr><td>Setup effort</td><td>Manual tour building</td><td>AI auto-generates from your product</td></tr>
      </tbody>
    </table>

    <div class="insight-box fade-up">
      <strong>Salesforce</strong> didn't reduce churn by building better tooltips. They built Trailhead — and created <strong>6 million certified professionals</strong> who will never leave. Certifly gives every SaaS that same superpower.
    </div>

    <p class="shift-close fade-up">
      The secret isn't teaching people how to <em>use</em> your product. It's teaching them to <strong>master the domain</strong> your product serves — and giving them a credential that proves it.
    </p>
  </div>
</section>

<div class="section-divider"></div>

<!-- ═══════ SECTION 4: HOW IT WORKS ═══════ -->
<section class="how-it-works section-pad">
  <div class="container">
    <h2 class="fade-up">Live in <span class="gradient-text">Minutes</span>. Not Months.</h2>
    <p class="muted fade-up">Three steps from install to your first certified user.</p>

    <div class="steps-grid">
      <div class="step-card fade-up">
        <div class="step-number">01</div>
        <div class="step-icon">⚡</div>
        <h3>Install in 3 Lines of Code</h3>
        <p>Add our lightweight SDK to your SaaS. Under 30KB. Zero impact on performance. Works with any web framework.</p>
        <div class="step-code">
          <span class="kw">&lt;script</span> <span class="str">src</span>=<span class="str">"https://cdn.certifly.tech/v1/certifly.min.js"</span><span class="kw">&gt;&lt;/script&gt;</span><br>
          <span class="kw">&lt;script&gt;</span><br>
          &nbsp;&nbsp;Certifly.init({'{'} <span class="str">apiKey</span>: <span class="str">'cf_live_xxx'</span> {'}'});<br>
          <span class="kw">&lt;/script&gt;</span>
        </div>
      </div>
      <div class="step-card fade-up">
        <div class="step-number">02</div>
        <div class="step-icon">🤖</div>
        <h3>AI Maps Your Product & Generates Tracks</h3>
        <p>Our AI observes your product's structure, understands your domain, and suggests a complete certification track — checkpoints, quizzes, and all. You review and publish.</p>
      </div>
      <div class="step-card fade-up">
        <div class="step-number">03</div>
        <div class="step-icon">🎓</div>
        <h3>Users Get Certified. You Get Retention.</h3>
        <p>Users complete checkpoints through real usage. Pass knowledge quizzes. Earn a professional credential they share on LinkedIn. You get users who deeply understand — and never leave — your product.</p>
      </div>
    </div>
    <p class="how-close fade-up">No instructional design team. No LMS license. No months of content creation.</p>
  </div>
</section>

<div class="section-divider"></div>

<!-- ═══════ SECTION 5: OFFER STACK ═══════ -->
<section class="offer section-pad">
  <div class="container">
    <h2 class="fade-up">Everything You Need to Turn Your SaaS Into a <span class="gradient-text">Certification Authority</span></h2>

    <div class="offer-grid">
      {[
        { label: "The Engine", title: "AI-Powered Track Generator", desc: "Our AI analyzes your product and generates professional certification tracks automatically. Domain-focused, not tool-focused. Your users become industry-certified through your product.", value: "Replaces $15,000+ instructional design cost" },
        { label: "The SDK", title: "Embedded Certification Widget", desc: "Lightweight JavaScript SDK embeds directly in your SaaS. Progress tracking, checkpoint validation, quiz engine — all inside your product. Zero friction.", value: "Replaces $1,000+/mo LMS licenses" },
        { label: "The Credential", title: "Verifiable Professional Certificates", desc: "Shareable on LinkedIn. Publicly verifiable. Branded with YOUR domain authority. Not a gamification badge — a career-advancing professional credential.", value: "Each share = organic brand impression" },
        { label: "The Intelligence", title: "Engagement Analytics Dashboard", desc: "See exactly where users get stuck, which features are undiscovered, and which paths drive retention. Data you've never had before.", value: "Better signal than NPS or usage analytics" },
      ].map(card => (
        <div class="offer-card fade-up">
          <div class="offer-label">{card.label}</div>
          <h3>{card.title}</h3>
          <p>{card.desc}</p>
          <div class="offer-value">{card.value}</div>
        </div>
      ))}
    </div>

    <div class="offer-stack-summary fade-up">
      <div class="stack-items">
        <span>AI Track Generation — <strong>$15,000 value</strong></span>
        <span>Embedded Certification SDK — <strong>$12,000/yr value</strong></span>
        <span>Verifiable Certificates — <strong>priceless for brand</strong></span>
        <span>Engagement Intelligence — <strong>$6,000/yr value</strong></span>
      </div>
      <div class="stack-total gradient-text">$33,000+/year in value</div>
      <div class="stack-price">Early Access: Free during beta → then starting at $299/mo</div>
      <div class="offer-cta-wrap">
        <WaitlistForm subText="Lock in founding member pricing. Limited spots." />
      </div>
    </div>
  </div>
</section>

<div class="section-divider"></div>

<!-- ═══════ SECTION 6: USE CASES ═══════ -->
<section class="use-cases section-pad">
  <div class="container">
    <h2 class="fade-up">What Does <span class="gradient-text">"Certified"</span> Look Like for Your Users?</h2>
    <div class="uc-grid">
      {useCases.map(uc => (
        <div class="uc-card fade-up">
          <div class="uc-industry">{uc.industry}</div>
          <h3>{uc.cert}</h3>
          <p class="uc-learn">{uc.learn}</p>
          <div class="uc-result">→ {uc.result}</div>
        </div>
      ))}
    </div>
    <p class="uc-close fade-up">
      You don't need to create the curriculum. Our AI reads your product, understands your domain, and suggests the certification track. You just review and publish.
    </p>
  </div>
</section>

<div class="section-divider"></div>

<!-- ═══════ SECTION 7: PROOF ═══════ -->
<section class="proof section-pad">
  <div class="container">
    <h2 class="fade-up">Why This Works <span class="gradient-text">(And Why Now)</span></h2>
    <div class="proof-grid">
      <div class="proof-card fade-up">
        <h3>📈 The giants already proved it</h3>
        <p class="proof-stat">6M+ Salesforce Trailhead certified professionals</p>
        <p class="proof-stat">HubSpot Academy grads show 2x higher retention</p>
        <p class="proof-stat">AWS cert holders spend 3x more on AWS services</p>
        <p>They proved certification drives retention and expansion. They just spent $50M+ building it. Certifly makes it accessible to every B2B SaaS.</p>
      </div>
      <div class="proof-card fade-up">
        <h3>🔮 The market is ready</h3>
        <p>Professional credentials are replacing vanity metrics. Audiences demand proof of expertise. The same shift is happening inside SaaS: users want certifications that advance their careers, not gamification badges that don't.</p>
      </div>
      <div class="proof-card fade-up">
        <h3>⚙️ Built for real SaaS teams</h3>
        <ul class="proof-bullets">
          <li>AI-first: certification tracks generated in minutes</li>
          <li>SDK under 30KB — your product won't slow down</li>
          <li>Privacy-first: we capture structure, never user data</li>
          <li>Works with React, Vue, Angular, or any web app</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<div class="section-divider"></div>

<!-- ═══════ SECTION 8: FAQ ═══════ -->
<section class="faq section-pad">
  <div class="container">
    <h2 class="fade-up" style="text-align:center;">Frequently Asked Questions</h2>
    <div class="faq-list">
      {faqs.map(faq => (
        <div class="faq-item fade-up">
          <button class="faq-q" aria-expanded="false">
            <span>{faq.q}</span>
            <span class="faq-arrow">+</span>
          </button>
          <div class="faq-a">{faq.a}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<div class="section-divider"></div>

<!-- ═══════ SECTION 9: FINAL CTA ═══════ -->
<section class="final-cta section-pad">
  <div class="container">
    <h2 class="fade-up">Stop Losing Users to Features <span class="gradient-text">They Never Discovered.</span></h2>
    <p class="fade-up">
      The first SaaS companies to offer professional certification will own their categories. Your users are already looking for credentials that advance their careers. The question is: will they get certified through <strong>your</strong> product — or someone else's?
    </p>
    <div class="fade-up">
      <WaitlistForm buttonText="Get Early Access →" subText="Founding members get free access + priority onboarding. No credit card. No commitment." />
    </div>
  </div>
</section>


<!-- FAQ accordion script -->
<script>
  document.querySelectorAll('.faq-q').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.parentElement!;
      const wasOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!wasOpen) item.classList.add('open');
      btn.setAttribute('aria-expanded', (!wasOpen).toString());
    });
  });
</script>

</Base>

<style>
  /* ═══════ HERO ═══════ */
  .hero { padding-top: 160px; padding-bottom: var(--section-pad); position: relative; overflow: hidden; }
  .hero::before { content: ''; position: absolute; top: -200px; right: -200px; width: 700px; height: 700px; border-radius: 50%; background: radial-gradient(circle, var(--glow-magenta) 0%, transparent 70%); pointer-events: none; }
  .hero::after { content: ''; position: absolute; bottom: -100px; left: -150px; width: 500px; height: 500px; border-radius: 50%; background: radial-gradient(circle, var(--glow-blue) 0%, transparent 70%); pointer-events: none; }
  .hero .container { position: relative; z-index: 1; }
  .hero-pretitle { font-size: 14px; font-weight: 500; color: var(--magenta); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 20px; }
  .hero h1 { max-width: 820px; margin-bottom: 24px; }
  .hero-sub { font-size: clamp(17px, 2vw, 20px); color: var(--text-secondary); max-width: 620px; margin-bottom: 36px; line-height: 1.6; }

  .hero-visual { margin-top: 72px; border-radius: 16px; border: 1px solid var(--border-subtle); background: var(--bg-card); padding: 32px; position: relative; overflow: hidden; }
  .hero-visual::before { content: ''; position: absolute; top: -1px; left: 0; right: 0; height: 2px; background: var(--gradient); }
  .hero-mockup { display: grid; grid-template-columns: 1fr 280px; gap: 24px; font-size: 14px; }
  .mockup-main h4 { color: var(--text-primary); font-size: 16px; margin-bottom: 12px; }
  .mockup-content { display: grid; gap: 12px; }
  .mockup-panel { background: rgba(255,255,255,0.03); border-radius: 8px; padding: 16px; }
  .mockup-panel-label { font-size: 13px; color: var(--text-muted); margin-bottom: 8px; }
  .mockup-bar { height: 8px; border-radius: 4px; background: rgba(255,255,255,0.06); margin-bottom: 8px; }
  .mockup-bar-fill { height: 100%; border-radius: 4px; background: var(--gradient); }
  .mockup-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .mockup-stat { background: rgba(255,255,255,0.03); border-radius: 8px; padding: 16px; }
  .mockup-stat-label { font-size: 12px; color: var(--text-muted); }
  .mockup-stat-value { font-size: 24px; font-weight: 700; font-family: Outfit; }
  .mockup-sidebar { border-left: 1px solid var(--border-subtle); padding-left: 24px; }
  .mockup-widget { background: rgba(241,0,255,0.04); border: 1px solid var(--border-glow); border-radius: 12px; padding: 20px; }
  .mockup-widget h4 { color: var(--text-primary); font-size: 14px; margin-bottom: 16px; }
  .mockup-widget-sub { font-size: 12px; color: var(--text-muted); margin-bottom: 12px; }
  .checkpoint { display: flex; align-items: center; gap: 10px; padding: 8px 0; font-size: 13px; color: var(--text-secondary); }
  .checkpoint-dot { width: 20px; height: 20px; border-radius: 50%; flex-shrink: 0; border: 2px solid rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; font-size: 10px; }
  .checkpoint-dot.done { background: var(--gradient); border-color: transparent; color: white; }
  .checkpoint-dot.active { border-color: var(--magenta); }
  .linkedin-btn { margin-top: 16px; padding: 8px 14px; border-radius: 6px; background: #0A66C2; color: white; font-size: 12px; font-weight: 600; display: inline-block; }
  .trust-bar { margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--border-subtle); color: var(--text-muted); font-size: 14px; display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .trust-tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .trust-tag { padding: 4px 12px; border-radius: 20px; font-size: 12px; border: 1px solid var(--border-subtle); color: var(--text-secondary); font-family: 'JetBrains Mono', monospace; }

  /* ═══════ PROBLEM ═══════ */
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 48px; }
  .stat-card { background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: 14px; padding: 32px; transition: border-color 0.3s, transform 0.3s; }
  .stat-card:hover { border-color: var(--border-glow); transform: translateY(-2px); }
  .stat-number { font-family: 'Outfit', sans-serif; font-size: clamp(36px, 4vw, 52px); font-weight: 800; line-height: 1; margin-bottom: 12px; }
  .stat-card h3 { margin-bottom: 8px; }
