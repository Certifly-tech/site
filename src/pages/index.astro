---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🚀 Welcome to Certifly Blog</h1>
			<p>
				Your source for data-driven insights on <strong>SaaS certification, customer retention strategies, and user engagement optimization</strong>.
			</p>
			
			<section>
				<h2>Latest Posts</h2>
				<ul>
					<li><a href="/blog/bem-vindo-a-certifly">Bem-vindo ao Certifly</a> - Onde a experiência técnica encontra a criação de conteúdo estratégico</li>
					<li><a href="/blog/first-post">First Post</a> - Example post</li>
					<li><a href="/blog/second-post">Second Post</a> - Example post</li>
				</ul>
			</section>

			<section>
				<h2>What You'll Find Here</h2>
				<ul>
					<li><strong>SaaS Certification Strategies:</strong> How to build certification programs that actually reduce churn</li>
					<li><strong>Customer Retention Insights:</strong> Data-backed approaches to keep users engaged</li>
					<li><strong>Technical Onboarding:</strong> Best practices for empowering users from day one</li>
					<li><strong>Growth Frameworks:</strong> Scalable approaches to SaaS product adoption</li>
				</ul>
			</section>

			<section>
				<h2>About Certifly</h2>
				<p>
					Certifly is reimagining how SaaS companies engage users through professional certification programs that deliver real career value.
				</p>
				<p>
					Our mission: Transform superficial gamification into meaningful credentialing that drives 3X higher retention.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
