---
// Landing page completa do Certifly - Static HTML
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SaaS Certification Program | Reduce Churn with Certifly</title>
  <meta name="description" content="Turn product usage into professional certifications. Reduce churn by 40%+ with AI-powered certification tracks embedded inside your SaaS. Join the waitlist.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://certifly.tech">
  <!-- Open Graph -->
  <meta property="og:title" content="Certifly — Professional Certification for SaaS">
  <meta property="og:description" content="Turn product usage into professional certifications. AI-powered. Embedded in your SaaS. Live in minutes.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://certifly.tech">
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Certifly — Professional Certification for SaaS">
  <meta name="twitter:description" content="Turn product usage into professional certifications. Reduce churn with AI-powered certification tracks.">
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <style>
    :root {
      --magenta: #f100ff;
      --deep-blue: #0000b8;
      --bg-dark: #0a0a1a;
      --bg-card: #111125;
      --bg-card-hover: #161635;
      --text-primary: #f0f0f5;
      --text-secondary: #9595b0;
      --text-muted: #6b6b85;
      --border-glow: rgba(241, 0, 255, 0.12);
      --border-subtle: rgba(255, 255, 255, 0.06);
      --gradient: linear-gradient(135deg, #f100ff, #0000b8);
      --gradient-text: linear-gradient(135deg, #f100ff, #7B68EE, #0000b8);
      --glow-magenta: rgba(241, 0, 255, 0.15);
      --glow-blue: rgba(0, 0, 184, 0.15);
      --max-w: 1140px;
      --section-pad: clamp(80px, 10vw, 140px);
    }
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    html {
      scroll-behavior: smooth;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      background: var(--bg-dark);
      color: var(--text-primary);
      line-height: 1.65;
      font-size: 17px;
      overflow-x: hidden;
    }
    .container {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 24px;
    }
    .gradient-text {
      background: var(--gradient-text);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .section-pad {
      padding: var(--section-pad) 0;
    }
    .muted {
      color: var(--text-secondary);
    }
    .text-muted {
      color: var(--text-muted);
    }
    h1, h2, h3, h4 {
      font-family: 'Outfit', sans-serif;
      line-height: 1.15;
      letter-spacing: -0.02em;
    }
    h1 {
      font-size: clamp(36px, 5.5vw, 62px);
      font-weight: 800;
    }
    h2 {
      font-size: clamp(28px, 3.5vw, 42px);
      font-weight: 700;
      margin-bottom: 24px;
    }
    h3 {
      font-size: clamp(18px, 2vw, 22px);
      font-weight: 600;
    }
    p {
      margin-bottom: 16px;
    }
    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 16px 0;
      background: rgba(10, 10, 26, 0.8);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-subtle);
      transition: all 0.3s;
    }
    .navbar .container {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .logo {
      font-family: 'Outfit', sans-serif;
      font-weight: 800;
      font-size: 22px;
      text-decoration: none;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .logo-svg {
      width: 30px;
      height: 30px;
      flex-shrink: 0;
    }
    .nav-cta {
      padding: 10px 24px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      background: var(--gradient);
      color: white;
      border: none;
      cursor: pointer;
      text-decoration: none;
      transition: opacity 0.2s;
    }
    .nav-cta:hover {
      opacity: 0.9;
    }
    .cta-form {
      display: flex;
      gap: 10px;
      max-width: 460px;
      flex-wrap: wrap;
    }
    .cta-form input[type="email"] {
      flex: 1;
      min-width: 220px;
      padding: 14px 18px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.1);
      background: rgba(255,255,255,0.05);
      color: var(--text-primary);
      font-size: 16px;
      font-family: 'DM Sans', sans-serif;
      outline: none;
      transition: border-color 0.3s;
    }
    .cta-form input[type="email"]::placeholder {
      color: var(--text-muted);
    }
    .cta-form input[type="email"]:focus {
      border-color: var(--magenta);
    }
    .cta-form button {
      padding: 14px 28px;
      border-radius: 10px;
      border: none;
      background: var(--gradient);
      color: white;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      font-family: 'DM Sans', sans-serif;
      white-space: nowrap;
      transition: transform 0.2s, box-shadow 0.3s;
    }
    .cta-form button:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 30px var(--glow-magenta);
    }
    .cta-sub {
      font-size: 13px;
      color: var(--text-muted);
      margin-top: 10px;
    }
    .hero {
      padding-top: 160px;
      padding-bottom: var(--section-pad);
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      top: -200px;
      right: -200px;
      width: 700px;
      height: 700px;
      border-radius: 50%;
      background: radial-gradient(circle, var(--glow-magenta) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero::after {
      content: '';
      position: absolute;
      bottom: -100px;
      left: -150px;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle, var(--glow-blue) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero .container {
      position: relative;
      z-index: 1;
    }
    .hero-pretitle {
      font-size: 14px;
      font-weight: 500;
      color: var(--magenta);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 20px;
    }
    .hero h1 {
      max-width: 820px;
      margin-bottom: 24px;
    }
    .hero-sub {
      font-size: clamp(17px, 2vw, 20px);
      color: var(--text-secondary);
      max-width: 620px;
      margin-bottom: 36px;
      line-height: 1.6;
    }
    .section-divider {
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--border-glow), transparent);
    }
    footer {
      padding: 48px 0;
      border-top: 1px solid var(--border-subtle);
      text-align: center;
      color: var(--text-muted);
      font-size: 13px;
    }
    footer .logo {
      display: inline-flex;
      margin-bottom: 16px;
      justify-content: center;
    }
    footer p {
      margin-bottom: 6px;
    }
    footer a {
      color: var(--text-secondary);
      text-decoration: none;
    }
    footer a:hover {
      color: var(--magenta);
    }
    @media (max-width: 768px) {
      .cta-form {
        flex-direction: column;
      }
      .cta-form input[type="email"] {
        min-width: 100%;
      }
      .cta-form button {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <noscript><style>.fade-up { opacity: 1 !important; transform: none !important; }</style></noscript>
  
  <nav class="navbar">
    <div class="container">
      <a href="/" class="logo">
        <svg class="logo-svg" viewBox="0 0 398.18 301.14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs><linearGradient id="logoGrad1" x1="356.6" y1="369.1" x2="743.1" y2="484.6" gradientUnits="userSpaceOnUse" gradientTransform="translate(-344.95,-334)"><stop stop-color="#f100ff"/><stop offset="1" stop-color="#0000b8"/></linearGradient></defs>
          <path d="m 220.05,89.01 c 2.93,-12.49 9.2,-24.01 15.58,-35 3.58,-6.18 8.24,-14.59 12.74,-20 18.76,-22.51 40.28,-34.34 69.68,-34 14.22,0.17 19.45,4.4 32,7.53 l 30,5.05 14.94,2.4 c 2.09,0.57 3.94,1.42 2.89,3.99 -0.96,2.35 -10.29,9.66 -12.83,12.06 -10.05,9.51 -20.63,18.05 -26.68,30.97 -9.33,19.94 -8.02,42.73 -10.6,64 -3.06,25.17 -13.01,55.35 -26.18,77 -28.44,46.72 -76.77,78.28 -129.54,90.76 -32.4,7.67 -57.2,7.62 -90,7.24 -18.15,-0.22 -42.48,-5.18 -60,-10.14 -13.71,-3.88 -29.6,-10.99 -42.05,-17.89 l 0.05,0.03 19,-2.28 36,-6.37 c 8.25,-1.89 13.21,-3.88 21,-6.66 31.6,-11.28 61.56,-29.59 82,-56.69 -13.72,-1.12 -30.35,-6.46 -43,-11.85 -11.55,-4.92 -18.6,-9.19 -29,-16.15 -33.47,-22.41 -53.66,-51.53 -64.71,-90 -4.39,-15.3 -7.29,-31.05 -7.29,-47 7.31,0.66 18.57,5.28 26,7.66 l 38,9.92 c 35.42,7.82 72.12,10.85 107,20.85 l 21,7.69 z" fill="url(#logoGrad1)"/>
        </svg>
        Certifly
      </a>
      <a href="#waitlist" class="nav-cta">Join Waitlist</a>
    </div>
  </nav>

  <section class="hero">
    <div class="container">
      <div class="hero-pretitle fade-up">For B2B SaaS with complex products</div>
      <h1 class="fade-up">
        SaaS Certification That Stops Churn at the Root.<br>
        <span class="gradient-text">Your Users Don't Leave Bad Products. They Leave Products They Never Truly Learned.</span>
      </h1>
      <p class="hero-sub fade-up">
        Certifly turns real product usage into professional certifications your users actually want to complete. AI-powered. Embedded in your SaaS. Live in minutes, not months.
      </p>
      <form class="cta-form fade-up" id="waitlist" onsubmit="handleWaitlist(event)">
        <input type="email" placeholder="your@workemail.com" required aria-label="Email address">
        <button type="submit">Join the Waitlist →</button>
      </form>
      <p class="cta-sub fade-up">Free early access. No credit card. Launching Q2 2026.</p>
    </div>
  </section>

  <section class="section-pad">
    <div class="container">
      <h2 class="fade-up">The <span class="gradient-text">$1.6 Trillion</span> SaaS Churn Problem Nobody's Actually Solving</h2>
      <p class="muted fade-up">Here's what's really happening inside your SaaS right now.</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 48px;">
        <div style="background: #111125; border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 14px; padding: 32px;">
          <div style="font-family: 'Outfit', sans-serif; font-size: 52px; font-weight: 800; line-height: 1; margin-bottom: 12px; background: linear-gradient(135deg, #f100ff, #7B68EE, #0000b8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">80%</div>
          <h3>of your features are invisible</h3>
          <p style="color: #9595b0; font-size: 15px;">Your users live in 3-4 screens. The other 80% of what you built? They don't know it exists.</p>
        </div>
        <div style="background: #111125; border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 14px; padding: 32px;">
          <div style="font-family: 'Outfit', sans-serif; font-size: 52px; font-weight: 800; line-height: 1; margin-bottom: 12px; background: linear-gradient(135deg, #f100ff, #7B68EE, #0000b8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">5-7%</div>
          <h3>monthly revenue lost to churn</h3>
          <p style="color: #9595b0; font-size: 15px;">Not because the product failed. Because users never reached the moment where your product becomes indispensable.</p>
        </div>
        <div style="background: #111125; border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 14px; padding: 32px;">
          <div style="font-family: 'Outfit', sans-serif; font-size: 52px; font-weight: 800; line-height: 1; margin-bottom: 12px; background: linear-gradient(135deg, #f100ff, #7B68EE, #0000b8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">3%</div>
          <h3>product tour completion rate</h3>
          <p style="color: #9595b0; font-size: 15px;">You spent $50K/year on onboarding tools. Users click "Skip" on every tooltip.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad" style="text-align: center;">
    <div class="container">
      <h2 class="fade-up">Stop Losing Users to Features <span class="gradient-text">They Never Discovered.</span></h2>
      <p class="fade-up" style="max-width: 600px; margin: 0 auto 36px;">
        The first SaaS companies to offer professional certification will own their categories. Your users are already looking for credentials that advance their careers.
      </p>
      <form class="cta-form fade-up" onsubmit="handleWaitlist(event)">
        <input type="email" placeholder="your@workemail.com" required aria-label="Email address">
        <button type="submit">Get Early Access →</button>
      </form>
    </div>
  </section>

  <footer>
    <div class="container">
      <a href="/" class="logo">
        <svg class="logo-svg" viewBox="0 0 398.18 301.14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs><linearGradient id="logoGrad2" x1="356.6" y1="369.1" x2="743.1" y2="484.6" gradientUnits="userSpaceOnUse" gradientTransform="translate(-344.95,-334)"><stop stop-color="#f100ff"/><stop offset="1" stop-color="#0000b8"/></linearGradient></defs>
          <path d="m 220.05,89.01 c 2.93,-12.49 9.2,-24.01 15.58,-35 3.58,-6.18 8.24,-14.59 12.74,-20 18.76,-22.51 40.28,-34.34 69.68,-34 14.22,0.17 19.45,4.4 32,7.53 l 30,5.05 14.94,2.4 c 2.09,0.57 3.94,1.42 2.89,3.99 -0.96,2.35 -10.29,9.66 -12.83,12.06 -10.05,9.51 -20.63,18.05 -26.68,30.97 -9.33,19.94 -8.02,42.73 -10.6,64 -3.06,25.17 -13.01,55.35 -26.18,77 -28.44,46.72 -76.77,78.28 -129.54,90.76 -32.4,7.67 -57.2,7.62 -90,7.24 -18.15,-0.22 -42.48,-5.18 -60,-10.14 -13.71,-3.88 -29.6,-10.99 -42.05,-17.89 l 0.05,0.03 19,-2.28 36,-6.37 c 8.25,-1.89 13.21,-3.88 21,-6.66 31.6,-11.28 61.56,-29.59 82,-56.69 -13.72,-1.12 -30.35,-6.46 -43,-11.85 -11.55,-4.92 -18.6,-9.19 -29,-16.15 -33.47,-22.41 -53.66,-51.53 -64.71,-90 -4.39,-15.3 -7.29,-31.05 -7.29,-47 7.31,0.66 18.57,5.28 26,7.66 l 38,9.92 c 35.42,7.82 72.12,10.85 107,20.85 l 21,7.69 z" fill="url(#logoGrad2)"/>
        </svg>
        Certifly
      </a>
      <p>Professional Certification for SaaS</p>
      <p style="margin-top:12px;">
        <a href="/privacy">Privacy Policy</a> · <a href="/terms">Terms of Service</a>
      </p>
      <p style="margin-top:8px;">© 2026 Certifly. All rights reserved.</p>
    </div>
  </footer>

  <script>
    function handleWaitlist(e) {
      e.preventDefault();
      const input = e.target.querySelector('input[type="email"]');
      const email = input.value;
      const btn = e.target.querySelector('button');
      btn.textContent = '✓ You\u2019re on the list!';
      btn.style.background = '#037f4c';
      btn.disabled = true;
      input.disabled = true;
      input.value = '';
      setTimeout(() => {
        btn.textContent = 'Join the Waitlist →';
        btn.style.background = '';
        btn.disabled = false;
        input.disabled = false;
      }, 4000);
    }
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    
    document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
  </script>
</body>
</html>